Options -Indexes -MultiViews
DirectoryIndex index.php index.html

# Make sure modern image formats are served with a correct MIME type.
# Apache 2.4 ships without AVIF in mime.types, so without this line the
# hero artwork is delivered with an empty Content-Type and some browsers
# refuse to paint it.
AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg

# Protect sensitive files
<FilesMatch "\.(sql|md|log|env|json|yaml|yml|ini|txt|bak|old|swp)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(README|composer)\.(md|json)$">
  Require all denied
</FilesMatch>

# Never let a browser read the override files themselves
<FilesMatch "^\.htaccess$">
  Require all denied
</FilesMatch>

# Block web access to configuration, code, private data, SQL dumps and
# command-line tools. Each of those folders also carries its own
# .htaccess, so the block survives even if this file is replaced.
#
# This rule is written relative to this folder on purpose. The old
# version was anchored with ^/ and therefore only worked when the app
# sat in the web root — under http://localhost/reagansoft-innovation/
# it matched nothing, leaving config/ reachable.
RewriteEngine On
RewriteRule ^(?:config|inc|storage|database|system|website|sql|frontend|tools)(?:/|$) - [R=403,L]

# React SPA. Real files and folders (api, admin, client, uploads, *.php,
# app assets) keep serving directly. Everything else, including the site
# root, is handed to the PHP shell so BrowserRouter deep links work.
RewriteRule ^$ spa.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ spa.php [L]

# Security headers (also applied in PHP for non-Apache setups)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# No pretty-URL routing is used — every page is a real file, so unknown
# paths should produce a genuine 404 rather than a silent fallback.
ErrorDocument 404 "Page not found."