Options -Indexes

# Protect sensitive files
<FilesMatch "\.(sql|md|log|env|json|yaml|yml|ini|txt)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(README|composer)\.(md|json)$">
  Require all denied
</FilesMatch>

# Block access to configuration and includes from the web
RedirectMatch 403 ^/(config|inc|storage)(/|$)

# Security headers (also applied in PHP for non-Apache setups)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# No pretty-URL routing is used — every page is a real file, so unknown
# paths should produce a genuine 404 rather than a silent fallback.
ErrorDocument 404 "Page not found."